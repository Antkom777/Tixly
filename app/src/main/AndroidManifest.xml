<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Дозволи для роботи з календарем -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Дозвіл для читання файлів -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Дозвіл на доступ до Інтернету для реклами (якщо потрібно) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Дозвіл на управління зовнішнім сховищем для Android 11+ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Дозвіл на запит усіх пакетів для вирішення намірів -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".TixlyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- Головна активність - список квитків -->
        <activity
            android:name=".TicketsActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent filter для відкриття PDF файлів -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Intent filter для отримання PDF через Share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Допоміжна активність MainActivity для обробки PDF -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Активність для редагування квитків -->
        <activity
            android:name=".TicketEditActivity"
            android:exported="false"
            android:parentActivityName=".TicketsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".TicketsActivity" />
        </activity>

        <!-- Активність налаштувань -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".TicketsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".TicketsActivity" />
        </activity>

        <!-- FileProvider для безпечного доступу до PDF файлів -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.tixly.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
