<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ticket_title_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTicketTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ticket_venue_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTicketVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/ticket_date_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTicketDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <!-- Save ticket button -->
            <ImageButton
                android:id="@+id/buttonSaveTicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="@string/save_ticket_desc"
                android:padding="12dp"
                android:layout_weight="1" />

            <!-- Copy data from another ticket button -->
            <ImageButton
                android:id="@+id/buttonCopyTicketData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_add"
                android:contentDescription="@string/copy_ticket_data_desc"
                android:padding="12dp"
                android:layout_weight="1" />

            <!-- Open attachment button -->
            <ImageButton
                android:id="@+id/buttonOpenTicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="@string/open_attachment_desc"
                android:padding="12dp"
                android:layout_weight="1" />

            <!-- Replace attachment button -->
            <ImageButton
                android:id="@+id/buttonReplacePdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="@string/replace_attachment_desc"
                android:padding="12dp"
                android:layout_weight="1" />

            <!-- Delete ticket button -->
            <ImageButton
                android:id="@+id/buttonDeleteTicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="@string/delete_ticket_desc"
                android:padding="12dp"
                android:layout_weight="1" />


        </LinearLayout>

    </LinearLayout>

</ScrollView>
